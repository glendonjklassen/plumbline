{
  "name": "plumbline-web",
  "private": true,
  "version": "0.53.0",
  "type": "module",
  "scripts": {
    "dev": "npm run pack:i18n && vite",
    "build": "npm run pack:i18n && vite build",
    "check": "npm run pack:i18n && npm run check:i18n && svelte-check --tsconfig ./tsconfig.json",
    "pack:hymnal": "node ../../scripts/build-hymnal.mjs",
    "pack:chronological": "node ../../scripts/build-chronological.mjs",
    "pack:data": "npm run pack:hymnal && npm run pack:chronological && node ../../scripts/build-web-pack.mjs && node ../../scripts/check-web-pack.mjs",
    "pack:wasm": "node scripts/copy-wasm.mjs",
    "pack:fonts": "node scripts/subset-fonts.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test --grep-invert @perf && playwright test --grep @perf --workers=1",
    "test:e2e:perf": "playwright test --grep @perf --workers=1",
    "pack:check": "node ../../scripts/check-web-pack.mjs",
    "pack:i18n": "node scripts/gen-i18n.mjs",
    "check:i18n": "node ../../scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^26.1.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
