<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- The binding is just two source files: the generated P/Invoke shim and the
       hand-written idiomatic wrapper. A real WinUI app references them the same way. -->
  <ItemGroup>
    <Compile Include="../PureStudyNative.g.cs" />
    <Compile Include="../PureStudy.cs" />
  </ItemGroup>

  <!-- Copy the native library next to the app so DllImport("pure_ffi") resolves.
       On Linux that is libpure_ffi.so; on Windows pure_ffi.dll. Build it with a
       release cargo build of pure-ffi first. -->
  <ItemGroup>
    <None Include="../../../../../target/release/libpure_ffi.so"
          Condition="Exists('../../../../../target/release/libpure_ffi.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libpure_ffi.so" />
  </ItemGroup>

</Project>
